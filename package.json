{
  "name": "musikademy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node --require ./scripts/exfat-fs-patch.cjs node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "build:local": "node --require ./scripts/exfat-fs-patch.cjs node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-musikademy \"vitest run --config vitest.rules.config.mts\"",
    "emulators": "firebase emulators:start",
    "seed": "node --require ./scripts/exfat-fs-patch.cjs node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "bootstrap-admin": "node --require ./scripts/exfat-fs-patch.cjs node_modules/tsx/dist/cli.mjs scripts/bootstrap-admin.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage --project musikademy-56b76"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.31.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
