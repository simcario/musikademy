# Firebase Web SDK (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Emulatori locali (true = usa Auth/Firestore/Storage emulator)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase Admin SDK (solo server). Su Firebase App Hosting non servono:
# vengono usate le Application Default Credentials.
# In locale: percorso del JSON del service account (NON committarlo).
GOOGLE_APPLICATION_CREDENTIALS=

# Worker WhatsApp (whatsapp-worker/, `npm run whatsapp`) — tutte facoltative
# Mostra la finestra di WhatsApp Web (default: sì su Windows/macOS, no su server senza schermo)
WHATSAPP_SHOW_BROWSER=
# Chrome/Edge già installato invece di quello scaricato da Puppeteer
WHATSAPP_CHROME_PATH=
# Cartella della sessione (default whatsapp-worker/.wwebjs_auth) — NON condividerla
WHATSAPP_DATA_DIR=

# WhatsApp con l'API ufficiale tramite Zernio (ADR D25) — solo server, in produzione come segreti App Hosting
ZERNIO_API_KEY=
# Facoltativo: se su Zernio ci sono più numeri WhatsApp, l'ID dell'account da usare
ZERNIO_WHATSAPP_ACCOUNT_ID=
# Segreto del job Cloud Scheduler che chiama POST /api/cron/whatsapp (promemoria)
CRON_SECRET=
