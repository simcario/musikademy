rules_version = '2';

// Musikademy — Storage Security Rules. Limiti allineati a src/lib/files.ts.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isStaff() { return role() in ['admin', 'teacher']; }
    function isStudent() { return role() == 'student'; }
    // Permessi del ruolo (ADR D31), come in firestore.rules.
    function can(p) {
      return role() == 'admin' || (role() == 'teacher' && (request.auth.token.get('perms', null) == null || p in request.auth.token.perms));
    }
    function mb(n) { return n * 1024 * 1024; }

    function validMaterialUpload() {
      let ct = request.resource.contentType;
      let size = request.resource.size;
      return (ct == 'application/pdf' && size <= mb(50))
        || (ct.matches('audio/(mpeg|mp3|wav|x-wav|wave|mp4|x-m4a|m4a|aac)') && size <= mb(100))
        || (ct.matches('video/(mp4|quicktime)') && size <= mb(500))
        || (ct.matches('image/(jpeg|png|webp)') && size <= mb(20))
        || (ct.matches('text/(markdown|x-markdown)') && size <= 512 * 1024);
    }

    // Lo studente scarica un file solo se può leggere il documento `materials` corrispondente.
    function me() {
      return firestore.get(/databases/(default)/documents/students/$(request.auth.uid)).data;
    }
    function studentCanReadMaterial(materialId) {
      let m = firestore.get(/databases/(default)/documents/materials/$(materialId)).data;
      return m.visibility == 'all'
        || request.auth.uid in m.get('studentIds', [])
        // `audience` (ADR D26): gruppi del materiale + studenti e gruppi della sua cartella.
        || request.auth.uid in m.get('audience', [])
        || (m.visibility == 'course' && m.get('courseId', '') in me().get('courseIds', []))
        || m.get('audience', []).hasAny(me().get('groupIds', []));
    }

    // Il docente legge i file dei propri materiali (ADR D34); quelli di un materiale non ancora
    // salvato (subito dopo il caricamento) li legge chi li ha caricati, cioè lo staff.
    function staffCanReadMaterial(materialId) {
      let path = /databases/(default)/documents/materials/$(materialId);
      return role() == 'admin' || !firestore.exists(path)
        || firestore.get(path).data.get('createdBy', '') == request.auth.uid;
    }

    match /materials/{materialId}/{fileName} {
      allow read: if (isStaff() && staffCanReadMaterial(materialId)) || (isStudent() && studentCanReadMaterial(materialId));
      allow create, update: if can('materials:manage') && validMaterialUpload();
      allow delete: if can('materials:manage');
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if signedIn();
      allow write: if can('announcements:manage') && request.resource.size <= mb(20);
      allow delete: if can('announcements:manage');
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= mb(5);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
